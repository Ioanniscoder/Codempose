{
  "name": "Codempose - Python",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/Codempose",
  "forwardPorts": [8888, 8000],
  "postCreateCommand": "pip install -r requirements.txt",
  "portsAttributes": {
    "8888": {
      "label": "Outputs HTTP server",
      "onAutoForward": "openBrowser",
      "protocol": "http",
      "description": "Serves generated artifacts from outputs/"
    },
    "8000": {
      "label": "Optional app port",
      "onAutoForward": "notify",
      "protocol": "http",
      "description": "Generic forwarded port"
    }
  },
  "postStartCommand": "bash .devcontainer/devcontainer-start.sh",
  
  // Add this section:
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "fernandoescolar.vscode-solution-explorer"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": true
        },
        "explorer.decorations.badges": true,
        "workbench.editor.decorations.badges": true,
       "terminal.integrated.defaultProfile.linux": "bash",
       "terminal.integrated.profiles.linux": {
         "bash": {
           "path": "/bin/bash"
         }
       }
      }
    }
  }
}