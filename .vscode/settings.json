{
  // Workspace hint for human readers and some tools/extensions.
  "preferredAssistantLanguage": "en",
  "assistant.preferredLanguage": "en",
  "remote.portsAttributes": {
    "8000": {
      "label": "Outputs Server (8000)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8888": {
      "label": "Devcontainer Server (8888)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  // Enable Copilot agent tools
  "github.copilot.chat.edits.enabled": true,
  "github.copilot.chat.runCommand.enabled": true,
  "github.copilot.chat.mcp.enabled": true,
  "github.copilot.chat.executeCodeEnabled": true
}

