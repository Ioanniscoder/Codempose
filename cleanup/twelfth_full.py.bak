"""
TWELFTH STUDY: All Transformations on a Single Line
====================================================

This study demonstrates the complete four-station workflow with all relevant
music21 transformations applied to a single melodic snippet.

Four-Station Workflow:
1. Station 1 (LilyPond): Original snippet - the source of truth
2. Station 2 (TinyNotation): Auto-generated equivalent representation
3. Station 3 (Shorthand): Arrange voices using declarative shorthand notation
4. Station 4 (Programmatic): Apply all transformations and document them

Structure:
- Identity (original snippet)
- Intermezzo (harmony - recurring between transformations)
- All transformations (transpose, invert, retrograde, augment, diminish, octave shifts)

PROMOTION TOGGLES:
- PROMOTE_TO_TINYNOTATION: When True, TinyNotation becomes the dominant format
- PROMOTE_TO_PROGRAMMATIC: When True, programmatic code dominates over shorthand
"""

# ============================================================================
# PROMOTION TOGGLES
# ============================================================================

PROMOTE_TO_TINYNOTATION = False
PROMOTE_TO_PROGRAMMATIC = False


# ============================================================================
# IMPORTS
# ============================================================================

from typing import Dict, List
import copy
import music21

from lilypond_parser import parse_lilypond_to_data
from music_data import extract_data_from_part, data_to_part
from voice_documentation import register_and_document_voice
from composition_shorthand import (
    build_score_from_assignments,
    transpose_events,
    invert_events
)


# ============================================================================
# STATION 1: ORIGINAL LILYPOND SNIPPET
# ============================================================================

# The single source of truth - our melodic snippet (no accidentals for clarity)
SOURCE_MELODY_LILY = r"\relative e { \time 6/4 \key c \major \tempo 4=90 e2 b4 c2 r4 | e2 f4 e2 r4 | b2. f'2. | e2. c2. | e2 b2 c2 }"


# ============================================================================
# STATION 2: TINYNOTATION EQUIVALENT
# ============================================================================

# Auto-generated by the parser - will be populated during build
SOURCE_MELODY_TINY = "tinynotation: 6/4 e2 b4 c'2 r4 e'2 f'4 e'2 r4 b'2. f''2. e''2. c''2. e''2 b''2 c'''2"


# ============================================================================
# STATION 3: SHORTHAND STRUCTURE
# ============================================================================

# Declarative arrangement: Identity + Intermezzo + All Transformations
# Each transformation is separated by the INTERMEZZO harmony
VOICE_ASSIGNMENTS = {
    'SingleLine': {
        # Identity (original snippet)
        'Original': 'SNIPPET',
        
        # Intermezzo (harmony - chordified snippet)
        'Intermezzo_1': 'HARMONY',
        
        # Transformation 1: Transposed up P5
        'Transposed_P5': 'SNIPPET_TRANSPOSED_P5',
        
        # Intermezzo (recurring)
        'Intermezzo_2': 'HARMONY',
        
        # Transformation 2: Inverted around C4
        'Inverted_C4': 'SNIPPET_INVERTED_C4',
        
        # Intermezzo (recurring)
        'Intermezzo_3': 'HARMONY',
        
        # Transformation 3: Retrograde
        'Retrograde': 'SNIPPET_RETROGRADE',
        
        # Intermezzo (recurring)
        'Intermezzo_4': 'HARMONY',
        
        # Transformation 4: Augmented (x2 duration)
        'Augmented_x2': 'SNIPPET_AUGMENTED',
        
        # Intermezzo (recurring)
        'Intermezzo_5': 'HARMONY',
        
        # Transformation 5: Diminished (x0.5 duration)
        'Diminished_x0.5': 'SNIPPET_DIMINISHED',
        
        # Intermezzo (recurring)
        'Intermezzo_6': 'HARMONY',
        
        # Transformation 6: Octave up
        'Octave_Up': 'SNIPPET_OCTAVE_UP',
        
        # Intermezzo (recurring)
        'Intermezzo_7': 'HARMONY',
        
        # Transformation 7: Octave down
        'Octave_Down': 'SNIPPET_OCTAVE_DOWN',
    }
}


# ============================================================================
# STATION 4: PROGRAMMATIC GENERATION WITH DOCUMENTATION
# ============================================================================


# Transformation helper functions (music21-based)
def identity(part: music21.stream.Part) -> music21.stream.Part:
    """Return an independent copy of the part."""
    return copy.deepcopy(part)

def transpose_part(part: music21.stream.Part, interval: str) -> music21.stream.Part:
    """Transpose the part by an interval (e.g., 'P5', 'm3', 'M2')."""
    return part.transpose(interval)

def invert_part(part: music21.stream.Part, center_pitch: str) -> music21.stream.Part:
    """Invert pitches around a center pitch (e.g., 'C4')."""
    p = copy.deepcopy(part)
    from music21 import pitch, interval
    center = pitch.Pitch(center_pitch)
    notes = list(p.recurse().getElementsByClass(music21.note.Note))
    for n in notes:
        try:
            iv = interval.Interval(noteStart=center, noteEnd=n.pitch)
            inv = iv.complement
            n.pitch = center.transpose(inv)
        except Exception:
            continue
    return p

def retrograde_part(part: music21.stream.Part) -> music21.stream.Part:
    """Reverse the order of notes/rests."""
    p = copy.deepcopy(part)
    elems = [e for e in p.recurse().notesAndRests]
    newp = music21.stream.Part()
    for e in reversed(elems):
        try:
            newp.append(e.clone())
        except Exception:
            newp.append(copy.deepcopy(e))
    return newp

def augment_part(part: music21.stream.Part, factor: float) -> music21.stream.Part:
    """Augment durations by a factor (e.g., 2.0 = double)."""
    p = copy.deepcopy(part)
    for n in p.flat.notesAndRests:
        n.quarterLength *= factor
    return p

def diminish_part(part: music21.stream.Part, factor: float) -> music21.stream.Part:
    """Diminish durations by a factor (e.g., 2.0 = half)."""
    p = copy.deepcopy(part)
    for n in p.flat.notesAndRests:
        n.quarterLength /= factor
    return p

def chordify_part(part: music21.stream.Part) -> music21.stream.Part:
    """Convert to harmony (chordified version)."""
    return part.chordify()


def build_score_data() -> Dict[str, Dict]:
    """
    SIMPLIFIED TEST: Only engrave the original snippet to verify parser correctness.
    """
    print("\n" + "="*70)
    print("TWELFTH STUDY: Testing Original Snippet Only")
    print("="*70)
    
    # Parse the original snippet
    print("\n[Station 1] Parsing original LilyPond snippet...")
    parsed = parse_lilypond_to_data(SOURCE_MELODY_LILY, part_name='Melody')
    snippet_events = parsed.get('parts', {}).get('Melody', [])
    
    print(f"  ✓ Parsed snippet: {len(snippet_events)} events")
    print(f"\nFirst 5 events:")
    for i, event in enumerate(snippet_events[:5]):
        print(f"  {i+1}. {event}")
    
    metadata = parsed.get('metadata', {})
    metadata['title'] = 'Twelfth Study: Original Snippet Test'
    metadata['composer'] = 'Codempose Framework'
    
    print("\n" + "="*70)
    print("✅ Engraving only the original snippet")
    print("   Check outputs/twelfth.pdf to verify correctness")
    print("="*70)
    
    return {
        'metadata': metadata,
        'parts': {
            'Melody': snippet_events,
        }
    }


# ============================================================================
# ALTERNATIVE: FULLY PROGRAMMATIC (NO SHORTHAND)
# ============================================================================

def build_score_data_programmatic():
    """
    Alternative implementation: Build entire score programmatically.
    
    This bypasses the shorthand system entirely, giving you complete
    control over every detail. Uncomment in main to use this version.
    
    Set PROMOTE_TO_PROGRAMMATIC = True to enable this version.
    """
    print("\n🔧 PROGRAMMATIC MODE: Building without shorthand")
    
    # Parse original snippet
    parsed = parse_lilypond_to_data(SOURCE_MELODY_LILY, part_name='Melody')
    snippet_events = parsed.get('parts', {}).get('Melody', [])
    snippet_part = data_to_part(snippet_events, parsed.get('metadata', {}))
    
    # Generate transformations
    harmony = extract_data_from_part(chordify_part(snippet_part))
    transposed = extract_data_from_part(transpose_part(snippet_part, 'P5'))
    inverted = extract_data_from_part(invert_part(snippet_part, 'C4'))
    retrograde = extract_data_from_part(retrograde_part(snippet_part))
    augmented = extract_data_from_part(augment_part(snippet_part, 2.0))
    diminished = extract_data_from_part(diminish_part(snippet_part, 2.0))
    octave_up = extract_data_from_part(transpose_part(snippet_part, 'P8'))
    octave_down = extract_data_from_part(transpose_part(snippet_part, '-P8'))
    
    # Manual assembly: Identity + Intermezzo + Transformations
    single_line = []
    single_line.extend(snippet_events)           # Original
    single_line.extend(harmony)                  # Intermezzo 1
    single_line.extend(transposed)               # Transformation 1
    single_line.extend(harmony)                  # Intermezzo 2
    single_line.extend(inverted)                 # Transformation 2
    single_line.extend(harmony)                  # Intermezzo 3
    single_line.extend(retrograde)               # Transformation 3
    single_line.extend(harmony)                  # Intermezzo 4
    single_line.extend(augmented)                # Transformation 4
    single_line.extend(harmony)                  # Intermezzo 5
    single_line.extend(diminished)               # Transformation 5
    single_line.extend(harmony)                  # Intermezzo 6
    single_line.extend(octave_up)                # Transformation 6
    single_line.extend(harmony)                  # Intermezzo 7
    single_line.extend(octave_down)              # Transformation 7
    
    return {
        'metadata': {
            'title': 'Twelfth Study: Programmatic Mode',
            'composer': 'Codempose Framework',
        },
        'parts': {
            'SingleLine': single_line,
        }
    }


# ============================================================================
# MAIN EXECUTION
# ============================================================================

if __name__ == '__main__':
    from project_template import run_pipeline_from_file
    
    # Override build_score_data if programmatic mode is enabled
    if PROMOTE_TO_PROGRAMMATIC:
        print("\n🔄 PROMOTION: Using programmatic mode")
        build_score_data = build_score_data_programmatic
    
    print("\n💡 Key Features:")
    print("  1. Four-station workflow: LilyPond → TinyNotation → Shorthand → Programmatic")
    print("  2. All transformations are DOCUMENTED and REUSABLE")
    print("  3. Shorthand arranges: Identity + [Intermezzo + Transformation] × 7")
    print("  4. Intermezzo (harmony) recurs between each transformation")
    print("  5. Everything on a single line - complete transformation showcase")
    print("  6. MusicXML export for MuseScore compatibility")
    print("\n🎼 Documentation shows both LilyPond AND TinyNotation formats!\n")
    
    # Run the standard pipeline (handles LilyPond, MusicXML, promotion)
    run_pipeline_from_file(__file__)

